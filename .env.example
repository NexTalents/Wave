# Next.js / Clerk client
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Convex client (Next.js)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Convex deployment environment, not a client-side Next.js secret.
# Set with: npx convex env set CLERK_JWT_ISSUER_DOMAIN <Clerk Frontend API URL>
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-frontend-api-url

# Optional until INT-002; set in the Convex deployment environment when WhatsApp is enabled.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=

# Optional until AUTH-011; local/CI only, never commit real values.
WAVE_TEST_INDIVIDUAL_PASSWORD=
WAVE_TEST_INDIVIDUAL_EMAIL=
WAVE_TEST_BUSINESS_PASSWORD=
WAVE_TEST_BUSINESS_EMAIL=
WAVE_TEST_BUSINESS_NAME=
WAVE_TEST_ADMIN_EMAIL=
WAVE_TEST_ADMIN_PASSWORD=
