# Next.js / Clerk client
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Convex client (Next.js)
NEXT_PUBLIC_CONVEX_URL=

# Convex deployment environment, not a client-side Next.js secret.
# Set with: npx convex env set CLERK_JWT_ISSUER_DOMAIN <Clerk Frontend API URL>
CLERK_JWT_ISSUER_DOMAIN=

# WhatsApp / Convex deployment environment (required by INT-002)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=

# Playwright auth test credentials (local/CI only; never commit real values)
WAVE_TEST_INDIVIDUAL_EMAIL=
WAVE_TEST_INDIVIDUAL_PASSWORD=
WAVE_TEST_BUSINESS_EMAIL=
WAVE_TEST_BUSINESS_PASSWORD=
WAVE_TEST_BUSINESS_NAME=
WAVE_TEST_ADMIN_EMAIL=
WAVE_TEST_ADMIN_PASSWORD=
